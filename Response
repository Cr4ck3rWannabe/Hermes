CREATE OR REPLACE FUNCTION track_analytics_event(
  p_session_id VARCHAR,
  p_event_name VARCHAR,
  p_page VARCHAR,
  p_product_id UUID,
  p_metadata JSONB
) RETURNS JSON AS $$
DECLARE
  event_allowed BOOLEAN;
BEGIN
  SET search_path = public, pg_temp;
  
  -- Validate event name exists in allowed list
  SELECT EXISTS(
    SELECT 1 FROM allowed_events 
    WHERE event_name = p_event_name 
    AND active = true
  ) INTO event_allowed;
  
  IF NOT event_allowed THEN
    RAISE EXCEPTION 'Event type tidak valid';
  END IF;
  
  -- Validate metadata structure (basic check)
  IF p_metadata IS NOT NULL THEN
    -- Basic structure validation - metadata max 1KB
    IF jsonb_typeof(p_metadata) != 'object' THEN
      RAISE EXCEPTION 'Metadata harus berupa object';
    END IF;
    
    -- Prevent large metadata
    IF length(p_metadata::text) > 1024 THEN
      RAISE EXCEPTION 'Metadata terlalu besar';
    END IF;
  END IF;
  
  -- Insert analytics event
  INSERT INTO analytics_events (
    session_id,
    event_name,
    page,
    product_id,
    metadata
  ) VALUES (
    p_session_id,
    p_event_name, 
    p_page,
    p_product_id,
    p_metadata
  );
  
  RETURN json_build_object('success', true);
  
EXCEPTION WHEN OTHERS THEN
  RAISE EXCEPTION 'Gagal menyimpan analytics: %', SQLERRM;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

-- Grant execute permission to anonymous
GRANT EXECUTE ON FUNCTION track_analytics_event TO anon;
