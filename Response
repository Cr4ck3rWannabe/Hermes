-- Admin users (with explicit roles)
CREATE TABLE admin_users (
  user_id UUID PRIMARY KEY REFERENCES auth.users(id),
  role TEXT NOT NULL DEFAULT 'admin',
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- Products with constraints
CREATE TABLE products (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  name VARCHAR(255) NOT NULL,
  speed_mbps INTEGER NOT NULL CHECK (speed_mbps > 0),
  price DECIMAL(10,2) NOT NULL CHECK (price >= 0),
  region VARCHAR(50) NOT NULL CHECK (region IN ('JAVA', 'NON-JAWA')),
  description TEXT,
  badge VARCHAR(100),
  featured BOOLEAN DEFAULT false,
  active BOOLEAN DEFAULT true,
  sort_order INTEGER DEFAULT 0,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW()
);

-- Leads with historical snapshots
CREATE TABLE leads (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  name VARCHAR(255) NOT NULL,
  phone VARCHAR(20) NOT NULL,
  area VARCHAR(255) NOT NULL,
  product_id UUID NOT NULL REFERENCES products(id),
  product_name_snapshot VARCHAR(255) NOT NULL,
  speed_mbps_snapshot INTEGER NOT NULL,
  price_snapshot DECIMAL(10,2) NOT NULL,
  region_snapshot VARCHAR(50) NOT NULL,
  status VARCHAR(20) DEFAULT 'NEW' CHECK (status IN (
    'NEW', 'CONTACTED', 'WAITING', 'APPROVED', 'REJECTED', 'CANCELLED'
  )),
  notes TEXT,
  created_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  updated_at TIMESTAMP WITH TIME ZONE DEFAULT NOW(),
  approved_at TIMESTAMP WITH TIME ZONE
);

-- Customers with unique constraint
CREATE TABLE customers (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  lead_id UUID NOT NULL UNIQUE REFERENCES leads(id),
