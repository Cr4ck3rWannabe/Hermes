## **8. ANTI-SPAM PROTECTION**

**Rate Limiting**:
```sql
-- Rate limiting function
CREATE OR REPLACE FUNCTION check_lead_rate_limit(p_phone VARCHAR)
RETURNS BOOLEAN AS $$
DECLARE
  recent_count INTEGER;
BEGIN
  SET search_path = public, pg_temp;
  
  -- Check if same phone number has submitted lead in last 1 hour
  SELECT COUNT(*) INTO recent_count
  FROM leads
  WHERE phone = p_phone
  AND created_at > NOW() - INTERVAL '1 hour';
  
  -- Allow max 3 submissions per hour per phone number
  IF recent_count >= 3 THEN
    RAISE EXCEPTION 'Terlalu banyak提交 leads untuk nomor ini dalam 1 jam';
  END IF;
  
  RETURN true;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

-- Rate limiting in create_lead
CREATE OR REPLACE FUNCTION create_lead(...)
AS $$
DECLARE
  -- ... existing code ...
BEGIN
  -- ... existing validation ...
  
  -- Rate limiting check
  PERFORM check_lead_rate_limit(p_phone);
  
  -- ... rest of function ...
```

