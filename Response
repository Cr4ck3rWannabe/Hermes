## **1. PUBLIC LEAD INSERT KEUNCI**

**Masalah**: Anonymous user masih bisa bypass dengan direct Supabase insert.

**Solusi**: SECURITY DEFINER function
```sql
CREATE OR REPLACE FUNCTION create_lead(
  p_name VARCHAR,
  p_phone VARCHAR,
  p_area VARCHAR,
  p_product_id UUID
) RETURNS JSON AS $$
DECLARE
  product_record products%ROWTYPE;
  lead_id UUID;
BEGIN
  -- Security context
  SET search_path = public, pg_temp;
  
  -- Input validation
  IF length(trim(p_name)) < 2 THEN
    RAISE EXCEPTION 'Nama harus minimal 2 karakter';
  END IF;
  
  IF NOT (p_phone ~ '^(\+62|62|0)8[1-9][0-9]{6,10}$') THEN
    RAISE EXCEPTION 'Nomor WhatsApp tidak valid';
  END IF;
  
  -- Lookup active product from database
  SELECT * INTO product_record
  FROM products
  WHERE id = p_product_id 
  AND active = true;
  
  IF NOT FOUND THEN
    RAISE EXCEPTION 'Produk tidak valid atau tidak aktif';
  END IF;
  
  -- Create lead with snapshot from database
  INSERT INTO leads (
    name,
    phone,
    area,
    product_id,
    product_name_snapshot,
    speed_mbps_snapshot,
    price_snapshot,
    region_snapshot,
    status
  ) VALUES (
    p_name,
    p_phone,
    p_area,
    p_product_id,
    product_record.name,
    product_record.speed_mbps,
    product_record.price,
    product_record.region,
    'NEW'
  ) RETURNING id INTO lead_id;
  
  -- Return lead ID
  RETURN json_build_object(
    'success', true,
    'lead_id', lead_id
  );
  
EXCEPTION WHEN OTHERS THEN
  RAISE EXCEPTION 'Gagal membuat lead: %', SQLERRM;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

-- Restrict execute privilege
REVOKE EXECUTE ON FUNCTION create_lead FROM PUBLIC;
GRANT EXECUTE ON FUNCTION create_lead TO anon;
```

## **2. APPROVE_LEAD WAJIB MEMVALIDASI ADMIN**

```sql
CREATE OR REPLACE FUNCTION approve_lead(target_lead_id UUID)
RETURNS JSON AS $$
DECLARE
  lead_record leads%ROWTYPE;
  customer_record customers%ROWTYPE;
  admin_user_id UUID;
BEGIN
  -- Security context  
  SET search_path = public, pg_temp;
  
  -- Authorization check (Wajib!)
  IF NOT is_admin(auth.uid()) THEN
    RAISE EXCEPTION 'Unauthorized - Admin access required';
  END IF;
  
  -- Get admin user ID for audit log
  admin_user_id := auth.uid();
  
  BEGIN
    -- Validate lead exists and is valid for approval
    SELECT * INTO lead_record 
    FROM leads 
    WHERE id = target_lead_id 
    AND status = 'WAITING'
    FOR UPDATE; -- Lock row to prevent concurrent approval
    
    IF NOT FOUND THEN
      RAISE EXCEPTION 'Lead tidak ditemukan atau tidak dalam status approval';
    END IF;
    
    -- Create customer with historical snapshot
    INSERT INTO customers (
      lead_id,
      name,
      phone,
      area,
      product_id,
      product_name_snapshot,
      speed_mbps_snapshot,
      price_snapshot,
      region_snapshot,
      status
    ) VALUES (
      lead_record.id,
      lead_record.name,
      lead_record.phone,
      lead_record.area,
      lead_record.product_id,
      lead_record.product_name_snapshot,
      lead_record.speed_mbps_snapshot,
      lead_record.price_snapshot,
      lead_record.region_snapshot,
      'INSTALLATION'
    ) RETURNING * INTO customer_record;
    
    -- Update lead status and approval timestamp
    UPDATE leads 
    SET 
      status = 'APPROVED',
      approved_at = NOW(),
      updated_at = NOW()
    WHERE id = target_lead_id;
    
    -- Create audit log (dalam transaction yang sama)
    INSERT INTO audit_logs (
      admin_user_id,
      action,
      entity_type,
      entity_id,
      old_value,
      new_value
    ) VALUES (
      admin_user_id,
      'LEAD_APPROVED',
      'lead',
      target_lead_id,
      json_build_object('status', lead_record.status),
      json_build_object('status', 'APPROVED', 'customer_id', customer_record.id)
    );
    
    -- Return success
    RETURN json_build_object(
      'success', true,
      'customer_id', customer_record.id,
      'lead_id', target_lead_id
    );
    
  EXCEPTION WHEN OTHERS THEN
    RAISE EXCEPTION 'Approval gagal: %', SQLERRM;
  END;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

-- Restrict execute privilege  
REVOKE EXECUTE ON FUNCTION approve_lead FROM PUBLIC;
GRANT EXECUTE ON FUNCTION approve_lead TO authenticated;
```

## **3. SECURITY DEFINER HARDENING**

**is_admin() function**:
```sql
CREATE OR REPLACE FUNCTION is_admin(auth_uid UUID)
RETURNS BOOLEAN AS $$
BEGIN
  -- Security context
  SET search_path = public, pg_temp;
  
  -- Strict authorization check
  RETURN EXISTS (
    SELECT 1 FROM admin_users 
    WHERE user_id = auth_uid 
    AND role = 'admin'
  );
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

-- Restrict execute privilege
REVOKE EXECUTE ON FUNCTION is_admin FROM PUBLIC;
GRANT EXECUTE ON FUNCTION is_admin TO authenticated, anon;
```

**create_audit_log() function**:
```sql
CREATE OR REPLACE FUNCTION create_audit_log(
  p_admin_user_id UUID,
  p_action VARCHAR,
  p_entity_type VARCHAR,
  p_entity_id UUID,
  p_old_value JSONB DEFAULT NULL,
  p_new_value JSONB DEFAULT NULL
) RETURNS UUID AS $$
DECLARE
  log_id UUID;
BEGIN
  -- Security context
  SET search_path = public, pg_temp;
  
  -- Authorization check
  IF NOT is_admin(auth.uid()) THEN
    RAISE EXCEPTION 'Unauthorized - Admin access required';
  END IF;
  
  -- Ensure creating user is same as admin_user_id
  IF p_admin_user_id != auth.uid() THEN
    RAISE EXCEPTION 'Unauthorized - Cannot create audit log for other admin';
  END IF;
  
  -- Insert audit log
  INSERT INTO audit_logs (
    admin_user_id,
    action,
    entity_type,
    entity_id,
    old_value,
    new_value
  ) VALUES (
    p_admin_user_id,
    p_action,
    p_entity_type,
    p_entity_id,
    p_old_value,
    p_new_value
  ) RETURNING id INTO log_id;
  
  RETURN log_id;
  
EXCEPTION WHEN OTHERS THEN
  RAISE EXCEPTION 'Gagal membuat audit log: %', SQLERRM;
END;
$$ LANGUAGE plpgsql SECURITY DEFINER;

-- Restrict execute privilege
REVOKE EXECUTE ON FUNCTION create_audit_log FROM PUBLIC;
GRANT EXECUTE ON FUNCTION create_audit_log TO authenticated;
```

